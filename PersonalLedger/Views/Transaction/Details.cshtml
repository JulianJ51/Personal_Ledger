@model PersonalLedger.Models.ViewModels.TransactionDetailsViewModel

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h2 class="card-title mb-1">Transaction Details</h2>
                            <p class="text-muted mb-0">Transaction #@Model.Id</p>
                        </div>
                    </div>

                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    <form asp-controller="Transaction" asp-action="Details" asp-route-id="@Model.Id" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="AccountId" class="form-label">Account</label>
                            <select asp-for="AccountId" asp-items="Model.Accounts" class="form-select">
                                <option value="">Select an account</option>
                            </select>
                            <span asp-validation-for="AccountId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date" class="form-label">Date</label>
                            <input asp-for="Date" type="date" class="form-control" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CreditDebitIndicator" class="form-label">Credit / Debit</label>
                            <select asp-for="CreditDebitIndicator"
                                    asp-items="Html.GetEnumSelectList<PersonalLedger.Models.Enums.CreditDebitIndicator>()"
                                    class="form-select">
                                <option value="">Select credit or debit</option>
                            </select>
                            <span asp-validation-for="CreditDebitIndicator" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label">Amount</label>
                            <input asp-for="Amount" class="form-control" inputmode="decimal" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AccountBalance" class="form-label">Account Balance (optional)</label>
                            <input asp-for="AccountBalance" class="form-control" inputmode="decimal" />
                            <span asp-validation-for="AccountBalance" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RewardCategory" class="form-label">Reward Category (optional)</label>
                            <input asp-for="RewardCategory" class="form-control" />
                            <span asp-validation-for="RewardCategory" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Transaction" asp-action="Index" class="btn btn-outline-secondary">Back to Search</a>
                            <div class="d-flex gap-2">
                                <button type="submit" form="deleteTransactionForm" class="btn btn-outline-danger"
                                        onclick="return confirm('Are you sure you want to permanently delete this transaction?');">
                                    Delete
                                </button>
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            </div>
                        </div>
                    </form>

                    <form id="deleteTransactionForm" asp-controller="Transaction" asp-action="Delete"
                          asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
