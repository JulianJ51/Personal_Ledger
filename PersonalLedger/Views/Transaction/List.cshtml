@model PersonalLedger.Models.ViewModels.TransactionListViewModel

@{
    ViewData["Title"] = "Transactions";
}

<div class="container mt-5">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Transactions</h2>
            <p class="text-muted mb-0">@Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</p>
        </div>
        <a asp-controller="Transaction" asp-action="Index" class="btn btn-outline-primary">New Search</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <h6 class="text-muted">Total Credits</h6>
                <h3 class="text-success mb-0">@((Model.Summary.TotalCredits / 100m).ToString("C"))</h3>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <h6 class="text-muted">Total Debits</h6>
                <h3 class="text-danger mb-0">@((Model.Summary.TotalDebits / 100m).ToString("C"))</h3>
            </div></div>
        </div>
    </div>

    <div class="card shadow-sm mb-4"><div class="card-body">
        <h5 class="mb-3">Credit Card Spending by Reward Category</h5>
        @if (Model.Summary.RewardCategoryBreakdown.Count == 0)
        {
            <p class="text-muted mb-0">No reward category data is available for these transactions.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Reward Category</th><th class="text-end">Total Spend</th></tr></thead>
                <tbody>
                @foreach (var category in Model.Summary.RewardCategoryBreakdown)
                {
                    <tr><td>@category.RewardCategory</td><td class="text-end">@((category.TotalSpend / 100m).ToString("C"))</td></tr>
                }
                </tbody>
            </table></div>
        }
    </div></div>

    <div class="card shadow-sm"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Transaction Results</h5>
            <span class="text-muted">@Model.Transactions.Count transaction(s)</span>
        </div>
        @if (Model.Transactions.Count == 0)
        {
            <div class="alert alert-info mb-0">No transactions were found within the selected date range.</div>
        }
        else
        {
            <div class="table-responsive"><table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Date</th><th>Description</th><th>Account</th><th>Institution</th><th>Type</th><th class="text-end">Amount</th><th class="text-end">Category</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    <tr>
                        <td>@transaction.Date.ToString("MM/dd/yyyy")</td>
                        <td>@transaction.Description</td>
                        <td>@transaction.Account.AccountName</td>
                        <td>@transaction.Account.Institution</td>
                        <td>@transaction.CreditDebitIndicator</td>
                        <td class="text-end">@((transaction.Amount / 100m).ToString("C"))</td>
                        <td class="text-end">@(transaction.RewardCategory ?? "N/A")</td>
                        <td class="text-end">
                            <a asp-controller="Transaction" asp-action="Details" asp-route-id="@transaction.Id"
                               class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </div></div>
</div>
