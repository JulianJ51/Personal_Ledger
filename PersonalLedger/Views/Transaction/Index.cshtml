
@model PersonalLedger.Models.ViewModels.TransactionQueryViewModel

@{
    ViewData["Title"] = "Transaction Query";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="card-title mb-2">Transaction Query</h2>
                    <p class="text-muted mb-4">
                        Select a date range to view your transactions.
                    </p>

                    <form asp-controller="Transaction"
                          asp-action="List"
                          method="get">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartDate"
                                   class="form-label">
                                Start Date
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="EndDate"
                                   class="form-label">
                                End Date
                            </label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="EndDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Search Transactions
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
