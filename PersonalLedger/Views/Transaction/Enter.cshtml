@model PersonalLedger.ViewModels.ManualTransactionViewModel

@{
    ViewData["Title"] = "Enter Transaction";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-2">Enter Transaction</h2>
                <p class="text-muted mb-4">
                    Manually add a transaction to one of your accounts.
                </p>

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">
                        @successMessage
                    </div>
                }

                @if (Model.AccountOptions.Count == 0)
                {
                    <div class="alert alert-warning" role="alert">
                        No accounts are available. Add an account before entering a transaction.
                    </div>
                }

                <form asp-controller="Transaction"
                      asp-action="Enter"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountId" class="form-label"></label>
                        <select asp-for="AccountId"
                                asp-items="Model.AccountOptions"
                                class="form-select">
                            <option value="">Select an account</option>
                        </select>
                        <span asp-validation-for="AccountId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreditDebitIndicator" class="form-label"></label>
                        <select asp-for="CreditDebitIndicator"
                                asp-items="Html.GetEnumSelectList<PersonalLedger.Models.Enums.CreditDebitIndicator>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="CreditDebitIndicator" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount"
                               type="text"
                               inputmode="decimal"
                               placeholder="0.00"
                               autocomplete="off"
                               class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="RewardCategory" class="form-label"></label>
                        <input asp-for="RewardCategory" class="form-control" />
                        <span asp-validation-for="RewardCategory" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Transaction"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@(Model.AccountOptions.Count == 0)">
                            Save Transaction
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
