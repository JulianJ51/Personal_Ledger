@model PersonalLedger.Models.ViewModels.ManualTransactionViewModel

@{
    ViewData["Title"] = "Enter Transaction";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="card-title mb-2">Enter Transaction</h2>
                    <p class="text-muted mb-4">Manually add a transaction to one of your accounts.</p>

                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    <form asp-controller="Transaction" asp-action="Enter" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="AccountId" class="form-label">Account</label>
                            <select asp-for="AccountId" asp-items="Model.Accounts" class="form-select">
                                <option value="">Select an account</option>
                            </select>
                            <span asp-validation-for="AccountId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date" class="form-label">Date</label>
                            <input asp-for="Date" type="date" class="form-control" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CreditDebitIndicator" class="form-label">Credit / Debit</label>
                            <select asp-for="CreditDebitIndicator"
                                    asp-items="Html.GetEnumSelectList<PersonalLedger.Models.Enums.CreditDebitIndicator>()"
                                    class="form-select">
                                <option value="">Select credit or debit</option>
                            </select>
                            <span asp-validation-for="CreditDebitIndicator" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label">Amount</label>
                            <input asp-for="Amount" class="form-control" inputmode="decimal" placeholder="0.00" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RewardCategory" class="form-label">Reward Category (optional)</label>
                            <input asp-for="RewardCategory" class="form-control" />
                            <span asp-validation-for="RewardCategory" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Save Transaction</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
